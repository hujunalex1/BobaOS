# Keep the SDK on disk intact. During reboot a new, incomplete BLOB_DATA chunk
# must not be mistaken for the previous committed version of that blob.
function(yumo_configure_nvs_blob_recovery)
    idf_component_get_property(nvs_dir nvs_flash COMPONENT_DIR)
    idf_component_get_property(nvs_lib nvs_flash COMPONENT_LIB)
    set(upstream "${nvs_dir}/src/nvs_page.cpp")
    file(READ "${upstream}" source)
    string(REPLACE "\r\n" "\n" source "${source}")
    string(FIND "${source}" "esp_err_t Page::mLoadEntryTable()" begin)
    string(FIND "${source}" "esp_err_t Page::initialize()" end)
    if(begin LESS 0 OR end LESS_EQUAL begin)
        message(FATAL_ERROR "Unsupported ESP-IDF NVS recovery implementation")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${source}" ${begin} ${length} original)
    string(SHA256 original_sha "${original}")
    if(NOT original_sha STREQUAL "18bd65e6c91795ea7115ac9c05c60ff33e9343f29ca0e7db1ffc06a9a8ee5a9c")
        message(FATAL_ERROR "ESP-IDF NVS recovery changed; review the blob chunk identity fix before building")
    endif()
    set(old "findItem(item.nsIndex, item.datatype, item.key, findItemIndex, dupItem)")
    set(new "findItem(item.nsIndex, item.datatype, item.key, findItemIndex, dupItem, item.chunkIndex)")
    string(REPLACE "${old}" "${new}" fixed "${original}")
    if(fixed STREQUAL original)
        message(FATAL_ERROR "Expected reviewed NVS duplicate-chunk check")
    endif()
    string(REPLACE "${original}" "${fixed}" adapted "${source}")
    set(generated "${CMAKE_BINARY_DIR}/yumo_adapters/nvs_page.cpp")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/yumo_adapters")
    set(write_adapter TRUE)
    if(EXISTS "${generated}")
        file(READ "${generated}" existing)
        if(existing STREQUAL adapted)
            set(write_adapter FALSE)
        endif()
    endif()
    if(write_adapter)
        file(WRITE "${generated}" "${adapted}")
    endif()
    get_target_property(sources ${nvs_lib} SOURCES)
    set(replaced 0)
    set(adapted_sources)
    foreach(path IN LISTS sources)
        if(path MATCHES "(^|[/\\])nvs_page[.]cpp$")
            list(APPEND adapted_sources "${generated}")
            math(EXPR replaced "${replaced} + 1")
        else()
            list(APPEND adapted_sources "${path}")
        endif()
    endforeach()
    if(NOT replaced EQUAL 1)
        message(FATAL_ERROR "Expected exactly one ESP-IDF NVS page source")
    endif()
    set_property(TARGET ${nvs_lib} PROPERTY SOURCES "${adapted_sources}")
    target_include_directories(${nvs_lib} PRIVATE "${nvs_dir}/src")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream}")
endfunction()

yumo_configure_nvs_blob_recovery()
