# Keep configuration in the project root and generated secrets in the build tree.
function(yumo_configure_vault_sync_key config_file output_dir)
    if(NOT EXISTS "${config_file}")
        message(FATAL_ERROR "Missing firmware/vault-sync-key.properties")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${config_file}")
    file(STRINGS "${config_file}" config_lines ENCODING UTF-8)
    set(key_found FALSE)
    foreach(line IN LISTS config_lines)
        string(STRIP "${line}" line)
        if(line STREQUAL "" OR line MATCHES "^#")
            continue()
        endif()
        if(key_found OR NOT line MATCHES "^sync\\.key\\.hex[ \t]*=[ \t]*([0-9a-fA-F]+)$")
            message(FATAL_ERROR "Invalid sync configuration: use one sync.key.hex entry with 64 hexadecimal characters")
        endif()
        set(key_hex "${CMAKE_MATCH_1}")
        string(LENGTH "${key_hex}" key_length)
        if(NOT key_length EQUAL 64)
            message(FATAL_ERROR "sync.key.hex must contain exactly 64 hexadecimal characters")
        endif()
        set(key_found TRUE)
    endforeach()
    if(NOT key_found)
        message(FATAL_ERROR "Missing sync.key.hex in firmware/vault-sync-key.properties")
    endif()
    set(YUMO_SYNC_KEY_BYTES "")
    foreach(index RANGE 0 31)
        math(EXPR offset "${index} * 2")
        string(SUBSTRING "${key_hex}" ${offset} 2 byte)
        string(APPEND YUMO_SYNC_KEY_BYTES "0x${byte},")
    endforeach()
    file(MAKE_DIRECTORY "${output_dir}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/vault_sync_key.hpp.in"
                   "${output_dir}/vault_sync_key_generated.hpp" @ONLY)
endfunction()
