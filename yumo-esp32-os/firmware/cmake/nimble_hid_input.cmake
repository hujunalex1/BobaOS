# Build a checked copy of the official NimBLE HID implementation. The SDK on
# disk stays unmodified; only input_set is replaced by the failure-safe adapter.
function(yumo_configure_nimble_hid_input)
    if(NOT CONFIG_BT_NIMBLE_ENABLED)
        return()
    endif()
    idf_component_get_property(hid_dir esp_hid COMPONENT_DIR)
    idf_component_get_property(hid_lib esp_hid COMPONENT_LIB)
    set(upstream "${hid_dir}/src/nimble_hidd.c")
    set(adapter "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/nimble_hid_input.inc")
    file(READ "${upstream}" source)
    string(REPLACE "\r\n" "\n" source "${source}")
    set(first "static int nimble_hidd_dev_input_set(")
    set(next "static int nimble_hidd_dev_feature_set(")
    string(FIND "${source}" "${first}" begin)
    string(FIND "${source}" "${next}" end)
    if(begin LESS 0 OR end LESS_EQUAL begin)
        message(FATAL_ERROR "Unsupported ESP-IDF NimBLE HID input implementation")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${source}" ${begin} ${length} original)
    string(SHA256 original_sha "${original}")
    if(NOT original_sha STREQUAL "bea34938bca0571f9424f2543180427039b66e1e715c1ce57fb40bfd7d19bbfd")
        message(FATAL_ERROR "ESP-IDF HID input changed; review the resource-pressure adapter before building")
    endif()
    set(generated "${CMAKE_BINARY_DIR}/yumo_adapters/nimble_hidd.c")
    string(REPLACE "${original}" "#include \"${adapter}\"\n\n" adapted "${source}")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/yumo_adapters")
    # Avoid touching the generated file on an unchanged configure.
    set(write_adapter TRUE)
    if(EXISTS "${generated}")
        file(READ "${generated}" existing)
        if(existing STREQUAL adapted)
            set(write_adapter FALSE)
        endif()
    endif()
    if(write_adapter)
        file(WRITE "${generated}" "${adapted}")
    endif()
    get_target_property(sources ${hid_lib} SOURCES)
    set(replaced 0)
    set(adapted_sources)
    foreach(path IN LISTS sources)
        if(path MATCHES "(^|[/\\])nimble_hidd[.]c$")
            list(APPEND adapted_sources "${generated}")
            math(EXPR replaced "${replaced} + 1")
        else()
            list(APPEND adapted_sources "${path}")
        endif()
    endforeach()
    if(NOT replaced EQUAL 1)
        message(FATAL_ERROR "Expected exactly one ESP-IDF NimBLE HID source")
    endif()
    set_property(TARGET ${hid_lib} PROPERTY SOURCES "${adapted_sources}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream}" "${adapter}")
endfunction()

yumo_configure_nimble_hid_input()
